# Copia este archivo como .env y completa con tus credenciales reales

# Configuración de la base de datos Oracle
DB_HOST=tu_host_aqui
DB_PORT=1521
DB_SERVICE_NAME=tu_service_name_aqui
DB_USER=tu_usuario_aqui
DB_PASSWORD=tu_password_aqui

# TCP mantiene compatibilidad; TCPS requiere certificado/wallet del entorno Oracle.
DB_PROTOCOL=TCP
DB_CONNECT_TIMEOUT_SECONDS=5
DB_CALL_TIMEOUT_MS=30000
